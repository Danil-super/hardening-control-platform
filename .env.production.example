# Copy this file to .env on the dedicated control node. Never commit .env.
HCP_ADMIN_PASSWORD=replace-with-a-long-unique-password
HCP_AUTH_SECRET=replace-with-at-least-32-random-characters
HCP_AUDIT_HMAC_KEY=replace-with-a-separate-at-least-32-random-characters
HCP_BIND_ADDRESS=127.0.0.1
HCP_PORT=3000
# Необязательный прокси для исходящих HTTPS-загрузок с управляющего узла (например, Astra OVAL).
# Если прокси требует авторизацию, задайте URL только в локальном .env.
HCP_HTTP_PROXY=
HCP_HTTPS_PROXY=
HCP_NO_PROXY=127.0.0.1,localhost
# false — сценарии доступны только для просмотра. true — разрешает создавать YAML-черновики.
# На рабочем control node проверка и запуск пользовательского YAML остаются заблокированными.
HCP_ENABLE_CUSTOM_AUDITS=false
# Только за доверенным HTTPS-прокси, который перезаписывает X-Forwarded-Proto.
# Прямой HTTP-доступ к HCP должен оставаться закрытым; для localhost не требуется.
HCP_TRUSTED_TLS_PROXY=false
# Значение задаёт начальный режим до первого сохранения в разделе «Источники».
# online — Trivy обновляет CVE-базу по сети; offline — использует только локальный cache.
HCP_TRIVY_MODE=online
# Максимальный возраст базы CVE в часах. При превышении отчёт помечается как частичный.
HCP_TRIVY_MAX_DB_AGE_HOURS=168
# Необязательно: внутреннее OCI-зеркало для обновления базы в online-режиме.
# В offline-режиме cache должен быть загружен заранее; registry не опрашивается.
HCP_TRIVY_DB_REPOSITORY=
HCP_TRIVY_JAVA_DB_REPOSITORY=
# Необязательная предварительная сверка Ubuntu OSV. Пусто — отключено.
# Только CVE -> SHA-256 ранее импортированного снимка Canonical; пример см. docs/ubuntu-osv-report-preview.md.
# Выводы не подтверждены подписью издателя и не разрешают автоматические исправления.
HCP_UBUNTU_OSV_PREVIEW_PINS_JSON=
# Максимальный возраст ЛОКАЛЬНОГО импорта OSV в часах (не гарантирует актуальность данных Canonical).
HCP_UBUNTU_OSV_MAX_IMPORT_AGE_HOURS=168

# Начальный SHA-256 для предварительной сверки Debian Security Tracker.
# Обычно база загружается и выбирается через панель «Источники».
# Выбор в панели сохраняется в SQLite и имеет приоритет над этой переменной.
HCP_DEBIAN_TRACKER_PREVIEW_SHA256=
# Максимальный возраст локального импорта Debian (не является подтверждением свежести издателя).
HCP_DEBIAN_TRACKER_MAX_IMPORT_AGE_HOURS=168
# OpenSCAP требует oscap на целевом хосте. Для встроенного профиля Astra нужен SCE;
# профиль HCP передаётся автоматически, внешний SSG content готовится отдельно.
# Fallback для групп без профиля в «Политиках» и прямого запуска playbook.
# Планировщик через внутренний API применяет профили/исключения из панели по хостам.
HCP_OPENSCAP_DATASTREAM=
HCP_OPENSCAP_PROFILE=
# OWASP Dependency-Track: после первого запуска создайте API key в его UI.
# В контейнерном compose используйте http://dependency-track-api:8080.
HCP_DEPENDENCY_TRACK_URL=http://dependency-track-api:8080
HCP_DEPENDENCY_TRACK_API_KEY=
HCP_DEPENDENCY_TRACK_DB_PASSWORD=replace-with-a-separate-long-password
HCP_DEPENDENCY_TRACK_BIND_ADDRESS=127.0.0.1
HCP_DEPENDENCY_TRACK_PORT=8080
HCP_DEPENDENCY_TRACK_API_BIND_ADDRESS=127.0.0.1
HCP_DEPENDENCY_TRACK_API_PORT=8081
# URL API для браузера: при смене API_PORT или удалённом доступе измените и этот URL.
HCP_DEPENDENCY_TRACK_PUBLIC_API_URL=http://localhost:8081
# Ключ внутреннего API всех плановых проверок: agentless, packages, openscap.
# Нужен также для базового hcp-scheduled-audit.timer; сервис HCP должен работать.
# Сгенерируйте отдельное случайное значение не короче 32 символов.
HCP_SCHEDULE_API_KEY=replace-with-a-separate-at-least-32-random-characters
# Обычный SSH-аудит и глубокие проверки можно запускать на разных inventory-группах.
HCP_SCHEDULE_LIMIT=linux_hosts
HCP_SCHEDULE_PROFILE=basic_linux
HCP_SCHEDULE_DEEP_LIMIT=linux_hosts
# Сводка источников учитывает только свежие отчёты; по умолчанию — за 7 дней.
HCP_CORRELATION_MAX_AGE_HOURS=168
# Необязательно: адреса control node, которые нельзя автоматически блокировать через панель.
# HCP_CONTROL_IPS=192.168.1.2
