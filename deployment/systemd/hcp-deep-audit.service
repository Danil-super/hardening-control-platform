[Unit]
Description=Hardening Control Platform scheduled package and deep audit
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/hardening-control-platform
# Keep OpenSCAP opt-in: add openscap only after an SSG profile and a dedicated
# inventory group have been prepared.
Environment=HCP_DEEP_SCHEDULE_TASKS=packages
ExecStart=/usr/bin/docker compose exec -T -e HCP_SCHEDULE_TASKS=${HCP_DEEP_SCHEDULE_TASKS} hcp /usr/local/bin/hcp-scheduled-audit
