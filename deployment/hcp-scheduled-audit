#!/bin/sh
set -eu

HCP_SCHEDULE_PROFILE="${HCP_SCHEDULE_PROFILE:-basic_linux}"
HCP_SCHEDULE_LIMIT="${HCP_SCHEDULE_LIMIT:-linux_hosts}"
HCP_SCHEDULE_DEEP_LIMIT="${HCP_SCHEDULE_DEEP_LIMIT:-$HCP_SCHEDULE_LIMIT}"
HCP_SCHEDULE_TASKS="${HCP_SCHEDULE_TASKS:-agentless}"
HCP_SCHEDULE_LOCK="${HCP_SCHEDULE_LOCK:-/var/lib/hcp/scheduled-audit.lock}"

case "$HCP_SCHEDULE_PROFILE" in
  basic_linux|ssh_security|web_server|docker_host) ;;
  *) echo "Unsupported HCP_SCHEDULE_PROFILE: $HCP_SCHEDULE_PROFILE" >&2; exit 64 ;;
esac

case "$HCP_SCHEDULE_LIMIT" in
  *[!A-Za-z0-9_.:-]*|"") echo "HCP_SCHEDULE_LIMIT must be one inventory host or group." >&2; exit 64 ;;
esac

case "$HCP_SCHEDULE_DEEP_LIMIT" in
  *[!A-Za-z0-9_.:-]*|"") echo "HCP_SCHEDULE_DEEP_LIMIT must be one inventory host or group." >&2; exit 64 ;;
esac

case "$HCP_SCHEDULE_TASKS" in
  *[!a-z,]*|""|,*|*,) echo "HCP_SCHEDULE_TASKS must be a comma-separated list of agentless,packages,openscap." >&2; exit 64 ;;
esac

REPORT_RUN_ID="schedule-$(date -u +%Y%m%dT%H%M%SZ)"

run_agentless() {
  ansible-playbook -i /app/ansible/inventory.ini /app/ansible/playbooks/agentless-audit.yml \
    --limit "$HCP_SCHEDULE_LIMIT" \
    -e "audit_profile=$HCP_SCHEDULE_PROFILE" \
    -e "hcp_reports_dir=${HCP_REPORTS_DIR:-/var/lib/hcp/reports}" \
    -e "report_run_id=$REPORT_RUN_ID"
}

run_packages() {
  : "${HCP_SCHEDULE_API_KEY:?Set HCP_SCHEDULE_API_KEY before scheduling packages/Trivy scans.}"
  ansible-playbook -i /app/ansible/inventory.ini /app/ansible/playbooks/package-inventory.yml \
    --limit "$HCP_SCHEDULE_DEEP_LIMIT" \
    -e "hcp_reports_dir=${HCP_REPORTS_DIR:-/var/lib/hcp/reports}" \
    -e "report_run_id=$REPORT_RUN_ID"
  node -e '
    const endpoint = `http://127.0.0.1:${process.env.PORT || "3000"}/api/internal/scheduled/package-vulnerabilities`;
    fetch(endpoint, {
      method: "POST",
      headers: { "content-type": "application/json", "x-hcp-schedule-key": process.env.HCP_SCHEDULE_API_KEY },
      body: JSON.stringify({ reportRunId: process.env.REPORT_RUN_ID }),
    }).then(async (response) => {
      const body = await response.text();
      if (!response.ok) throw new Error(`${response.status}: ${body}`);
      process.stdout.write(`${body}\n`);
    }).catch((error) => { console.error(`Scheduled CVE scan failed: ${error.message}`); process.exit(1); });
  '
}

run_openscap() {
  ansible-playbook -i /app/ansible/inventory.ini /app/ansible/playbooks/openscap-audit.yml \
    --limit "$HCP_SCHEDULE_DEEP_LIMIT" \
    -e "hcp_reports_dir=${HCP_REPORTS_DIR:-/var/lib/hcp/reports}" \
    -e "report_run_id=$REPORT_RUN_ID"
}

run_tasks() {
  original_ifs="$IFS"
  IFS=","; set -- $HCP_SCHEDULE_TASKS; IFS="$original_ifs"
  for task in "$@"; do
    case "$task" in
      agentless) run_agentless ;;
      packages) run_packages ;;
      openscap) run_openscap ;;
      *) echo "Unsupported scheduled task: $task" >&2; exit 64 ;;
    esac
  done
}

export REPORT_RUN_ID
exec 9>"$HCP_SCHEDULE_LOCK"
flock -n 9 || { echo "Another scheduled audit is already running." >&2; exit 75; }
run_tasks
