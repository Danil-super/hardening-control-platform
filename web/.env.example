HCP_ADMIN_PASSWORD=replace-with-a-long-unique-password
HCP_AUTH_SECRET=replace-with-at-least-32-random-characters
HCP_AUDIT_HMAC_KEY=replace-with-a-separate-at-least-32-random-characters
# Начальный режим Trivy до первого сохранения в разделе «Источники».
# online — сетевое обновление CVE-базы, offline — только заранее загруженный cache.
HCP_TRIVY_MODE=online
# Максимальный возраст базы CVE в часах. При превышении отчёт помечается как частичный.
HCP_TRIVY_MAX_DB_AGE_HOURS=168
