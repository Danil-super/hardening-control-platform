HCP_ADMIN_PASSWORD=replace-with-a-long-unique-password
HCP_AUTH_SECRET=replace-with-at-least-32-random-characters
HCP_AUDIT_HMAC_KEY=replace-with-a-separate-at-least-32-random-characters
# Optional: enables authoring of custom audit YAML. Keep false on a working control node.
HCP_ENABLE_CUSTOM_AUDITS=false
# Начальный режим Trivy до первого сохранения в разделе «Источники».
# online — загрузка/обновление общей CVE-базы кнопкой в «Источниках», offline — только заранее загруженный cache.
HCP_TRIVY_MODE=online
# Необязательное внутреннее OCI-зеркало trivy-db. Несколько адресов разделяются запятой.
# Без этой переменной HCP использует официальные резервные registry Trivy.
# HCP_TRIVY_DB_REPOSITORY=registry.security.intra/trivy-db
# Максимальный возраст базы CVE в часах. При превышении отчёт помечается как частичный.
HCP_TRIVY_MAX_DB_AGE_HOURS=168
