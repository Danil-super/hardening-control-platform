      <ind:filepath var_ref="oval:org.hcp.astra:var:1"/>
      <ind:pattern operation="pattern match">^(?:ID=["']?astra["']?|ID_LIKE=["']?(?:[A-Za-z0-9_.-]+[ \t]+)*astra(?:[ \t]+[A-Za-z0-9_.-]+)*["']?)[ \t]*$</ind:pattern>
      <ind:instance datatype="int" operation="greater than or equal">1</ind:instance>
    </ind:textfilecontent54_object>
    <unix:sysctl_object id="oval:org.hcp.astra:obj:2" version="1">
