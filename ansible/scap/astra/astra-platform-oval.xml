  <definitions>
    <definition id="oval:org.hcp.astra:def:1" version="1" class="inventory">
      <metadata>
        <title>Astra operating-system family applicability</title>
        <description>HCP family identity from os-release ID or ID_LIKE; no version or architecture whitelist. This is inventory applicability, not a vulnerability definition.</description>
      </metadata>
      <criteria>
        <criterion test_ref="oval:org.hcp.astra:tst:1" comment="os-release identifies the Astra family"/>
      </criteria>
    </definition>
    <definition id="oval:org.hcp.astra:def:2" version="1" class="compliance">
      <metadata>
        <title>Current full address-space randomization</title>
        <description>Current kernel.randomize_va_space equals 2. Boot persistence and individual process exceptions are outside this check.</description>
      </metadata>
      <criteria>
        <criterion test_ref="oval:org.hcp.astra:tst:2" comment="kernel.randomize_va_space equals 2"/>
      </criteria>
    </definition>
  </definitions>
  <tests>
    <ind:textfilecontent54_test id="oval:org.hcp.astra:tst:1" version="1" check="at least one" check_existence="at_least_one_exists" comment="Astra family in os-release">
      <ind:object object_ref="oval:org.hcp.astra:obj:1"/>
    </ind:textfilecontent54_test>
    <unix:sysctl_test id="oval:org.hcp.astra:tst:2" version="1" check="all" check_existence="all_exist" comment="Full ASLR">
      <unix:object object_ref="oval:org.hcp.astra:obj:2"/>
      <unix:state state_ref="oval:org.hcp.astra:ste:2"/>
    </unix:sysctl_test>
  </tests>
  <objects>
